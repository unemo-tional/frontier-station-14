+    async def send_round_result(self, status: dict[str, Any]) -> None:
+        result = status.get("last_round_result")
+        if not isinstance(result, dict):
+            return
+        round_id = result.get("round_id")
+        ended_at = result.get("ended_at")
+        if not isinstance(round_id, int) or not isinstance(ended_at, str) or not ended_at:
+            return
+        marker = [round_id, ended_at]
+        if marker == self.last_end_notice:
+            return
+
+        try:
+            channel_id = int(os.getenv("ROUND_CHANNEL_ID", "").strip())
+            channel = self.get_channel(channel_id)
+            if channel is None:
+                channel = await self.fetch_channel(channel_id)
+            if not isinstance(channel, (discord.Thread, discord.TextChannel)):
+                log.error("ROUND_CHANNEL_ID is not a text channel or thread")
+                return
+            duration = format_duration(int(result["duration_seconds"]))
+            participants = int(result["participants"])
+            map_name = discord.utils.escape_markdown(str(result.get("map") or "неизвестна")[:100])
+            preset = discord.utils.escape_markdown(str(result.get("preset") or "не указан")[:100])
+            message = (
+                f"🏁 Раунд #{round_id} завершён\n"
+                f"**Итоги** · ⏱️ {duration} · 👥 Участников: {participants}\n"
+                f"Карта: {map_name} · Режим: {preset}"
+            )
+            rows = []
+            for entry in result.get("bank_results") or []:
+                name = " ".join(entry["character"].split())
+                change = f'{entry["change"]:+,}'.replace(",", " ")
+                rows.append(f'{name}: {change} кр.')
+            kwargs = {"allowed_mentions": discord.AllowedMentions.none()}
+            if rows:
+                heading = "\n\n**Прибыль и убытки персонажей**"
+                details = "\n".join(discord.utils.escape_markdown(row) for row in rows)
+                if len((message + heading + "\n" + details).encode("utf-16-le")) <= 4000:
+                    message += heading + "\n" + details
+                else:
+                    from io import BytesIO
+                    message += heading + " — в приложенном файле."
+                    kwargs["file"] = discord.File(
+                        BytesIO("\n".join(rows).encode("utf-8")),
+                        filename=f"round-{round_id}-bank-results.txt",
+                    )
+            await channel.send(message, **kwargs)
+            self.last_end_notice = marker
+            self.save_round_state()
+        except (KeyError, TypeError, ValueError, discord.HTTPException) as exc:
+            log.error("Could not send round result: %s", exc)
